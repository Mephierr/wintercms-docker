# ============================================
# Основные настройки приложения
# ============================================
APP_ENV=local
APP_DEBUG=true
APP_KEY="base64:q1+oEgG/zEKyOrRyagM8gL4Q0CKS0GTxXcoL3vo4Lb4="
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
APP_LOCALE=ru

# ============================================
# Настройки базы данных
# ============================================
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=winter
DB_USERNAME=winter
DB_PASSWORD=winter
DB_ROOT_PASSWORD=root
DB_PREFIX=null

# ============================================
# Настройки кэширования и сессий
# ============================================
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_DRIVER=sync

# ============================================
# Настройки почты (для установки и восстановления)
# ============================================
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Winter CMS"

# ============================================
# Настройки файловой системы
# ============================================
FILESYSTEM_DISK=local
FILESYSTEM_CLOUD=s3

# ============================================
# Настройки Redis (опционально)
# ============================================
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================
# Настройки отладки
# ============================================
DEBUGBAR_ENABLED=false
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ============================================
# Настройки Winter CMS
# ============================================
CMS_ROUTE_CACHE=false
CMS_ASSET_CACHE=false
CMS_LINK_POLICY=detect
CMS_ENABLE_CSRF=true
CMS_BACKEND_FORCE_HTTPS=false
CMS_BACKEND_URI=backend

# ============================================
# Настройки Docker-специфичные
# ============================================
DOCKER_MYSQL_VERSION=8.0
DOCKER_PHP_VERSION=8.1